{
  "datasets": [
    {
      "name": "positions",
      "displayName": "Current truck positions",
      "queryLines": [
        "SELECT truck_id, driver, region, home_depot, make, model,\n",
        "       from_utc_timestamp(event_ts, 'America/New_York') AS last_ping_et,\n",
        "       latitude, longitude, in_geofence\n",
        "FROM gold_truck_position"
      ]
    },
    {
      "name": "pings_5min",
      "displayName": "Pings per region per 5 minutes",
      "queryLines": [
        "SELECT window(from_utc_timestamp(s.event_ts, 'America/New_York'), '5 minutes').start AS window_start,\n",
        "       coalesce(d.region, 'unknown') AS region,\n",
        "       count(*) AS pings\n",
        "FROM silver_pings s\n",
        "LEFT JOIN truck_details d USING (truck_id)\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "quality",
      "displayName": "Silver vs quarantine",
      "queryLines": [
        "SELECT clean, quarantined, round(100.0 * quarantined / nullif(clean + quarantined, 0), 1) AS quarantine_pct\n",
        "FROM (SELECT (SELECT count(*) FROM silver_pings) AS clean,\n",
        "             (SELECT count(*) FROM silver_pings_quarantine) AS quarantined)"
      ]
    }
  ],
